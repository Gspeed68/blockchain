# Copy to .env and fill in for local/dev use. In production these come from
# the environment, never committed.

PORT=4100
LOG_LEVEL=info

# Reads (eth_call, eth_getTransactionReceipt, eth_getLogs, ...) go straight
# to a Besu node — no need to route them through Web3Signer.
BESU_RPC_URL=http://localhost:8545

# Writes (eth_accounts, eth_sendTransaction) go through Web3Signer, which
# signs with the vault-backed key and forwards the raw tx to Besu itself.
WEB3SIGNER_RPC_URL=http://localhost:9000

# Must match the target network's genesis config.chainId.
CHAIN_ID=190417

# Written by hardhat/scripts/deploy.ts after a real deploy. A placeholder
# ships in api/src/config/contract.json so the API can boot before a real
# network exists; every chain-touching endpoint will fail loudly until it's
# replaced with a real deployment's address.
CONTRACT_CONFIG_PATH=./src/config/contract.json

# Local file uploads for custody documents (bills of lading, inspection
# certs, damage photos) — off-chain storage for this POC. Swap for S3 by
# replacing api/src/services/uploadService.ts; the on-chain side only ever
# stores a URI + hash, so it doesn't care which backend serves that URI.
UPLOADS_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4100
