# Copy to .env and fill in for local/dev use. In production these come from
# the environment (systemd unit / docker-compose env_file on the EC2 host),
# never committed — see README-BOURBON-PORT.md.

PORT=4000
LOG_LEVEL=info

# Reads (eth_call, eth_getTransactionReceipt, eth_getLogs, ...) go straight
# to a Besu node — no need to route them through Web3Signer.
BESU_RPC_URL=http://localhost:8545

# Writes (eth_accounts, eth_sendTransaction) go through Web3Signer, which
# signs with the AWS-KMS-backed key and forwards the raw tx to Besu itself.
WEB3SIGNER_RPC_URL=http://localhost:9000

# Must match QBFT-Network/config/qbftConfigFile.json's genesis.config.chainId.
CHAIN_ID=190416

# Written by hardhat/scripts/deploy.ts after a real deploy. A placeholder
# ships in api/src/config/contract.json so the API can boot before a real
# network exists; every chain-touching endpoint will fail loudly until it's
# replaced with a real deployment's address.
CONTRACT_CONFIG_PATH=./src/config/contract.json

# --- Valuation source (see README-BOURBON-PORT.md "Valuation data source") ---
VALUATION_PROVIDER=whiskyhunter
# eBay Browse API is the documented fallback when WhiskyHunter has no match
# for a bottle (it skews Scotch/UK auction data). Needs an eBay developer
# app's OAuth application token — see api/src/services/valuation/ebayBrowseProvider.ts.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Local file uploads for bottle photos (off-chain storage for this POC —
# swap for S3 by replacing api/src/services/uploadService.ts; the on-chain
# side only ever stores a URI + hash, so it doesn't care which backend
# serves that URI).
UPLOADS_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000

# Scheduled valuation refresh (off by default — see services/scheduler.ts).
# Cron syntax; WhiskyHunter's own data updates daily, so anything more
# frequent than daily just burns their free API for no new data.
VALUATION_REFRESH_CRON=
